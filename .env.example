# FUTUREUNI Internal Platform: environment template
#
# Copy to .env.local for local development (Phase 1 generates it with local values).
# Every variable here is validated by the Zod schema in src/env.ts (Phase 1). Values below are
# PLACEHOLDERS ONLY. Never commit a real value; secrets go in Vercel's environment settings or,
# for provider API keys, in the platform's encrypted credentials vault (/admin/integrations).
#
# Provider keys are OPTIONAL while MOCKS=true, and REQUIRED in the production deployment (VERCEL_ENV=production)
# when MOCKS=false (open question for Phase 21: ADR-005, CR-01-11). A provider named in LIVE_PROVIDERS
# is live regardless of MOCKS, and its key is then required wherever the app boots.
# Adapters look for a key in the credentials vault first, then these env variables (ADR-005).

# ---------------------------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------------------------
# development | test | production
NODE_ENV="development"
# Public base URL of the app, no trailing slash (used in links, unsubscribe URLs, emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Dev server port (pnpm phase start sets 3000 + phase number in each worktree)
PORT="3000"
# Set to 1 only in CI steps that build or lint without real secrets
# SKIP_ENV_VALIDATION="1"

# ---------------------------------------------------------------------------------------------
# Mock mode (ADR-005)
# ---------------------------------------------------------------------------------------------
# true = every external provider uses its mock adapter (no network, no keys). Default for local and preview.
MOCKS="true"
# Providers that run LIVE even while MOCKS=true, comma-separated. Lets one integration go live
# before the rest have keys. Each one named here must have its key set, or start-up fails.
# Allowed: anthropic, google-places, pagespeed, youtube-data, serpapi, hunter, companies-house, resend, cal-com
LIVE_PROVIDERS=""
# Mock AI failure simulation for testing error paths: empty | invalid | timeout | 429
AI_MOCK_FAIL=""

# ---------------------------------------------------------------------------------------------
# Database: Neon in Vercel; local Postgres on localhost:5432, native or Docker (ADR-004, ADR-019)
# ---------------------------------------------------------------------------------------------
# Pooled connection used by the app at runtime (Neon "-pooler" host in Vercel; the Neon integration names it DATABASE_URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/futureuni_dev"
# Direct (non-pooled) connection used only by the Prisma CLI for migrations (prisma.config.ts datasource.url).
# In Vercel, set it to the value the Neon integration provides as DATABASE_URL_UNPOOLED.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/futureuni_dev"
# Test database (integration tests); worktrees use futureuni_test_p<nn>
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/futureuni_test"
# Local Postgres port (both modes)
POSTGRES_PORT="5432"
# How pnpm db:up / db:down and pnpm phase start reach local Postgres (ADR-004): native | docker.
# Leave empty to use docker when the docker command exists, otherwise native (the build laptop resolves to native).
LOCAL_DB_MODE=""
# Native mode only. Leave empty for the defaults:
#   %LOCALAPPDATA%\Programs\PostgreSQL\18\bin  and  %LOCALAPPDATA%\PostgreSQL\18\data
LOCAL_PG_BIN=""
LOCAL_PGDATA=""

# ---------------------------------------------------------------------------------------------
# Security secrets (generate each with: openssl rand -base64 32)
# ---------------------------------------------------------------------------------------------
# AES-256-GCM key for the credentials vault: 32 bytes, base64. LOSING IT MAKES STORED CREDENTIALS UNRECOVERABLE.
CREDENTIALS_ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"
# Key version stored with each encrypted credential (increment on rotation: pnpm credentials:rotate)
CREDENTIALS_KEY_VERSION="1"
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/tick
CRON_SECRET="REPLACE_WITH_RANDOM_SECRET"
# HMAC secret for signed unsubscribe tokens (/u/[token], /api/unsubscribe/[token])
UNSUBSCRIBE_TOKEN_SECRET="REPLACE_WITH_RANDOM_SECRET"
# HMAC secret for lead references embedded in booking links
BOOKING_LINK_SECRET="REPLACE_WITH_RANDOM_SECRET"
# HMAC-SHA256 key for hashed suppressions written by data-subject deletes (INV-10). Never rotate without
# re-hashing: a new key would stop existing hashed suppressions from matching.
SUPPRESSION_HASH_KEY="REPLACE_WITH_RANDOM_SECRET"

# ---------------------------------------------------------------------------------------------
# Auth: Better Auth (ADR-013)
# ---------------------------------------------------------------------------------------------
# Secret used to sign sessions and tokens (at least 32 characters)
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
# Base URL Better Auth uses for callbacks (same as NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL="http://localhost:3000"
# Optional Google sign-in, restricted to allowed domains (setting auth.googleAllowedDomains). Off by default.
AUTH_GOOGLE_ENABLED="false"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Development seed only: password given to every seeded user (never used in production)
SEED_USER_PASSWORD="change-me-local-only"
# Development seed only: skip forcing the seeded admin into 2FA setup
SEED_SKIP_2FA="false"
# Development seed only: allow seeding a non-local database (a Neon dev/preview branch). Never set in production.
# SEED_ALLOW_REMOTE="1"

# ---------------------------------------------------------------------------------------------
# AI: Anthropic through src/platform/ai only (ADR-006, ADR-018)
# ---------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Model tier defaults; the ai.modelTiers setting overrides them at runtime (ADMIN only)
AI_MODEL_FAST="claude-haiku-4-5"
AI_MODEL_BALANCED="claude-sonnet-5"
AI_MODEL_DEEP="claude-opus-5"
# Optional same-tier fallbacks used if the primary model is unavailable (leave empty for none)
AI_MODEL_FAST_FALLBACK=""
AI_MODEL_BALANCED_FALLBACK=""
AI_MODEL_DEEP_FALLBACK=""
# Spend cap for live eval runs (pnpm evals --live), in USD
EVALS_LIVE_MAX_USD="5"

# ---------------------------------------------------------------------------------------------
# File storage: Vercel Blob (ADR-003)
# ---------------------------------------------------------------------------------------------
# local = .storage/ folder (development and tests) | vercel-blob
STORAGE_DRIVER="local"
# Blob read-write token (set automatically when a Blob store is connected to the Vercel project)
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------------------------
# Platform (transactional) email: Resend (ADR-023). Never used for cold outreach.
# ---------------------------------------------------------------------------------------------
RESEND_API_KEY=""
# From address on the verified platform mail subdomain, e.g. "FUTUREUNI Platform <notifications@mail.example.com>"
EMAIL_FROM="FUTUREUNI Platform <notifications@example.com>"
EMAIL_REPLY_TO=""

# ---------------------------------------------------------------------------------------------
# Outreach sending and reply ingestion (ADR-016). Mailboxes and their tokens live in the database and vault.
# ---------------------------------------------------------------------------------------------
# gmail-api | smtp | mock
OUTREACH_SENDER="mock"
# gmail-api | imap | mock
INBOUND_SOURCE="mock"
# Google Cloud OAuth client (an "Internal" app in the dedicated outreach Workspace tenant, ADR-016) used to connect
# outreach mailboxes to the Gmail API. Per-mailbox refresh tokens live only in the vault (outreach-mailbox:<mailboxId>).
# The DKIM selector checked by the DNS check is stored per domain (SendingDomain.dkimSelector, default "google").
GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=""
GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=""

# ---------------------------------------------------------------------------------------------
# Sourcing providers (Phase 8)
# ---------------------------------------------------------------------------------------------
# Google Maps Platform key restricted to the Places API (New)
GOOGLE_PLACES_API_KEY=""
# SerpAPI (Google Jobs engine)
SERPAPI_API_KEY=""
# Adzuna API
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# YouTube Data API v3 key
YOUTUBE_API_KEY=""

# ---------------------------------------------------------------------------------------------
# Enrichment and compliance (Phase 9)
# ---------------------------------------------------------------------------------------------
# Email finder and verifier (ADR-020)
HUNTER_API_KEY=""
# UK Companies House public data API key (legal form for PECR, INV-6)
COMPANIES_HOUSE_API_KEY=""
# The crawler user agent's contact URL is the setting platform.crawlerContactUrl, not an env variable.

# ---------------------------------------------------------------------------------------------
# Audits (Phase 10)
# ---------------------------------------------------------------------------------------------
# Google PageSpeed Insights API key
PAGESPEED_API_KEY=""
# Headless browser runtime (ADR-017): vercel-sandbox (production) | serverless-chromium (fallback) | local-playwright | mock
BROWSER_RUNTIME="mock"
# Vercel Sandbox snapshot with Playwright + Chromium + axe pre-installed (auth is Vercel OIDC; run `vercel env pull` locally)
VERCEL_SANDBOX_SNAPSHOT_ID=""
# Fallback capture service (separate secret-free Vercel project) and the HMAC key used to sign requests to it
BROWSER_FALLBACK_URL=""
BROWSER_FALLBACK_SIGNING_KEY=""
# Optional path to a locally installed Chromium for local-playwright (leave empty to use Playwright's)
CHROMIUM_EXECUTABLE_PATH=""

# ---------------------------------------------------------------------------------------------
# Calendar and booking (ADR-021)
# ---------------------------------------------------------------------------------------------
CALCOM_API_KEY=""
# Secret used to verify Cal.com webhook signatures (X-Cal-Signature-256)
CALCOM_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------------------------
# Monitoring: Sentry (ADR-030). Switched on in Phase 21.
# ---------------------------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Used only in CI to upload source maps
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ---------------------------------------------------------------------------------------------
# Build-time tooling (read by .mcp.json from YOUR SHELL, not by the app). Keep them out of .env.local
# if you prefer; they are listed here so the full set of names lives in one place.
# ---------------------------------------------------------------------------------------------
# Claude Code reads these from the environment it is launched in, not from .env files.
# On Windows: setx GITHUB_MCP_PAT "github_pat_..." then open a new terminal.
# Fine-grained GitHub personal access token for the GitHub MCP server, scoped to this repo (only once the repo is on GitHub)
GITHUB_MCP_PAT=""
# Optional Context7 API key; .mcp.json uses the anonymous tier unless you add an Authorization header (docs/integrations.md)
CONTEXT7_API_KEY=""
