# Dependencies
node_modules/
.pnpm-store/

# Next.js and build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Environment files: never commit real values. .env.example is the only tracked env file.
.env
.env.*
!.env.example

# Vercel and Workflow local state (withWorkflow generates src/app/.well-known/workflow/ at build)
.vercel/
.workflow-data/
.workflow-vitest/
**/.well-known/workflow/
.swc/

# Certificates and keys
*.pem

# Generated Prisma client (prisma-client generator output; regenerated by pnpm db:generate)
src/generated/

# Playwright MCP output (screenshots and traces from visual checks)
.playwright-mcp/

# Audit walkthrough screenshots (local review material; the repo is public)
.walkthrough/

# Prisma
prisma/*.db
prisma/*.db-journal

# Local file storage adapter (src/platform/storage local driver)
.storage/

# Tests and tooling output
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
tests/e2e/.auth/
.vitest/

# Eval reports are generated; the case files under evals/ are tracked
evals/reports/

# Logs and OS files
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
*.swp

# Claude Code machine-local settings (project settings.json is tracked)
.claude/settings.local.json

# Sentry
.sentryclirc

# Vercel CLI link data
.vercel
