// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`email templates > plain-text version of budget-warning is snapshot-stable 1`] = `
"AI budget 80% used (platform.daily)

AI budget approaching limit

platform.daily has used 40.00 of 50.00 (80%).

FUTUREUNI · Transactional message."
`;

